@echo off
chcp 65001 >nul
title نظام إدارة المستأجرين
color 0A

echo.
echo ╔══════════════════════════════════════════════════════════════╗
echo ║                    نظام إدارة المستأجرين                    ║
echo ║                      Property Management System              ║
echo ╚══════════════════════════════════════════════════════════════╝
echo.

REM التحقق من وجود الملف التنفيذي
if not exist "mostager.exe" (
    echo ❌ خطأ: ملف mostager.exe غير موجود
    echo.
    echo 💡 يبدو أن عملية البناء لم تكتمل بعد
    echo    يرجى تشغيل build_exe.bat أولاً لإنشاء الملف التنفيذي
    echo.
    echo 📋 الخطوات المطلوبة:
    echo    1. انتقل إلى المجلد الرئيسي للمشروع
    echo    2. شغل build_exe.bat
    echo    3. انتظر انتهاء عملية البناء
    echo    4. عد إلى هذا المجلد وشغل هذا الملف مرة أخرى
    echo.
    pause
    exit /b 1
)

REM التحقق من وجود قاعدة البيانات
if not exist "database.db" (
    echo ⚠️  تحذير: ملف قاعدة البيانات غير موجود
    echo    سيتم إنشاؤه تلقائياً عند أول تشغيل
    echo.
)

REM عرض معلومات النظام
echo 🖥️  معلومات النظام:
echo    📁 المجلد الحالي: %CD%
echo    📅 التاريخ: %DATE%
echo    🕐 الوقت: %TIME%
echo.

REM تشغيل البرنامج
echo 🚀 جاري تشغيل نظام إدارة المستأجرين...
echo    يرجى الانتظار حتى يفتح البرنامج في المتصفح
echo.

REM تشغيل الملف التنفيذي
start "" "mostager.exe"

REM انتظار قصير للتأكد من بدء التشغيل
timeout /t 3 /nobreak >nul

echo ✅ تم تشغيل البرنامج بنجاح!
echo.
echo 💡 نصائح مهمة:
echo    • إذا لم يفتح البرنامج، تحقق من برامج مكافحة الفيروسات
echo    • للإغلاق، أغلق نافذة المتصفح أو اضغط Ctrl+C هنا
echo    • في حالة المشاكل، راجع ملف mostager.log
echo.
echo 📞 للدعم الفني، راجع ملف README.txt
echo.

REM انتظار إغلاق البرنامج
echo اضغط أي مفتاح لإغلاق هذه النافذة...
pause >nul